---
import FormattedDate from './FormattedDate.astro';
import { slugify } from '../utils/common-utils';

type Props = {
    publishDate: Date;
    updatedDate?: Date | undefined;
    excerpt?: string | undefined;
    tags?: string[];
    words: number;
    minutes: number;
};

const { publishDate, updatedDate, excerpt, tags = [], words, minutes } = Astro.props;
---

<div class="text-sm leading-relaxed">
    <div class="mb-6">
        <p class="text-muted mb-1">发布于</p>
        <p>
            <FormattedDate date={publishDate} />
        </p>
        {updatedDate && (
            <p class="text-muted mt-0.5">
                更新于 <FormattedDate date={updatedDate} />
            </p>
        )}
    </div>

    <div class="mb-6">
        <p class="text-muted mb-1">字数</p>
        <p>{words.toLocaleString('en-US')} 字，约 {minutes} 分钟</p>
    </div>

    {
        excerpt && (
            <div class="mb-6">
                <p class="text-muted mb-1">摘要</p>
                <p class="text-muted">{excerpt}</p>
            </div>
        )
    }

    {
        tags.length > 0 && (
            <div>
                <p class="text-muted mb-1">标签</p>
                <div class="flex flex-wrap gap-x-3 gap-y-1">
                    {tags.map((tag) => (
                        <a class="hover:underline hover:decoration-1 hover:underline-offset-4" href={`/tags/${slugify(tag)}`}>
                            #{tag}
                        </a>
                    ))}
                </div>
            </div>
        )
    }
</div>
