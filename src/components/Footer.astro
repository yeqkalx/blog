---
import siteConfig from '../data/site-config';

const socialLinks = siteConfig.socialLinks ?? [];
const navLinks = siteConfig.footerNavLinks ?? [];
const currentYear = new Date().getFullYear();
---

{/*
    Kept short: the theme default (`sm:pt-24`) left a large empty gap above the rule, so
    the paddings are trimmed to roughly the sticky header's height.
*/}
<footer class="pt-5 pb-6 sm:pt-6 sm:pb-8">
    {navLinks.length > 0 && (
        <div class="mx-auto w-full max-w-2xl">
            <nav class="mb-4 flex flex-wrap gap-x-6 gap-y-1" aria-label="Footer navigation">
                {navLinks.map((link) => (
                    <a class="text-muted hover:text-main text-sm transition-colors" href={link.href}>
                        {link.text}
                    </a>
                ))}
            </nav>
        </div>
    )}
    {/*
        The hairline runs edge to edge (same as the sticky header's), so it is pulled
        out of the page padding; the text inside stays in the centred site column.
    */}
    <div class="border-main -mx-4 border-t px-4 pt-5 md:-mx-8 md:px-8">
        <div
            class:list={[
                'text-muted mx-auto flex w-full max-w-2xl flex-col gap-3 text-[0.8125rem] leading-relaxed',
                { 'sm:flex-row-reverse sm:items-center sm:justify-between': socialLinks.length > 0 }
            ]}
        >
            {socialLinks.length > 0 && (
                <div class="flex flex-wrap gap-x-4 gap-y-1">
                    {socialLinks.map((link) => (
                        <a class="link-quiet inline-flex items-center justify-center" href={link.href} target="_blank" rel="noopener noreferrer">
                            {link.text}
                        </a>
                    ))}
                </div>
            )}
            <p class="flex flex-wrap gap-x-5 gap-y-1">
                <span>
                    &copy; {currentYear}{' '}
                    <a class="link-quiet" href="/">{siteConfig.title}</a>
                </span>
                <span>
                    All content licensed under{' '}
                    <a class="link-quiet" href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noopener noreferrer license">CC BY-NC-SA 4.0</a>
                </span>
                <span>
                    Powered by <a class="link-quiet" href="https://astro.build/">Astro</a> &amp;{' '}
                    <a class="link-quiet" href="https://github.com/JustGoodUI/dante-astro-theme">dante-astro-theme</a>
                </span>
            </p>
        </div>
    </div>
</footer>
