---
import siteConfig from '../data/site-config';
import CustomImage from './CustomImage.astro';

const titleClass = 'text-main text-[1.75rem] leading-tight font-semibold tracking-tight sm:text-[2rem]';
---

<header class="mx-auto mb-14 flex w-full max-w-2xl items-center gap-4 sm:mb-16">
    {siteConfig.avatar?.src && (
        <a href="/">
            <CustomImage
                class="aspect-square w-16 rounded-full object-cover sm:w-20"
                {...siteConfig.avatar}
                loading="eager"
                fetchpriority="high"
                width={80}
                height={80}
                widths={[80, 160]}
                sizes="80px"
            />
        </a>
    )}
    <div class="grow">
        {siteConfig.avatar?.src ? (
            <p class={titleClass}>{siteConfig.title}</p>
        ) : (
            <a class={titleClass} href="/">
                {siteConfig.title}
            </a>
        )}
        {siteConfig.subtitle && <p class="text-muted mt-1 text-sm leading-tight">{siteConfig.subtitle}</p>}
    </div>
</header>
