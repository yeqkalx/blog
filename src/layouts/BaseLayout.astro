---
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';

export type Props = HeadProps & {
    showHeader?: boolean;
    back?: { href: string; label: string } | undefined;
    /** Post pages push their reading grid beyond the 48rem site column to fit the side rails. */
    wide?: boolean;
};

const { showHeader = true, back, wide = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="zh-cn" class="wrap-break-words overflow-y-scroll antialiased">
    <head>
        <BaseHead {...head} />
        <script is:inline>
            try {
                if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.classList.add('dark');
                }
            } catch {}
        </script>
        <ClientRouter />
        <script is:inline src="/theme-toggle.js"></script>
    </head>
    <body class="bg-main text-main">
        <div class="flex min-h-screen flex-col px-4 md:px-8">
            <Nav back={back} />
            {showHeader && <Header />}
            <main class:list={['mx-auto w-full grow', wide ? 'max-w-none' : 'max-w-3xl']}>
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>
