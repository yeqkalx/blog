---
import Subscribe from '../../components/Subscribe.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getAllTaggedPosts, getPostsByTag, sortItemsByDateDesc } from '../../utils/data-utils';

// Both writing collections render tags in the post meta, so the directory and the
// per-tag archives have to be built from their union: filtering to `blog` alone is
// why Think Space tags never appeared anywhere.
const posts = (await getAllTaggedPosts()).sort((a, b) => sortItemsByDateDesc(a.post, b.post));

const tags = getAllTags(posts).sort((tagA, tagB) => {
    const postCountTagA = getPostsByTag(posts, tagA.id).length;
    const postCountTagB = getPostsByTag(posts, tagB.id).length;
    return postCountTagB - postCountTagA;
});
---

<BaseLayout
    title="Tags"
    description="Explore tag directory for easy navigation and discovery. Find a wide range of topics, articles, and insights organized by tags, making it effortless to locate the content that interests you most."
    showHeader={false}
>
    <h1 class="page-title">All Tags</h1>
    {tags.map((tag) => {
        const postCount = getPostsByTag(posts, tag.id).length;
        return (
            <a class="group mb-5 flex items-baseline justify-between gap-8" href={`/tags/${tag.id}`}>
                <h2 class="text-main text-[1.0625rem] leading-snug font-medium group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4 sm:text-lg">{tag.name}</h2>
                <div class="text-muted shrink-0 text-sm tabular-nums">
                    {postCount} {postCount === 1 ? 'post' : 'posts'}
                </div>
            </a>
        );
    })}
    <Subscribe class="my-16 sm:my-24" />
</BaseLayout>
